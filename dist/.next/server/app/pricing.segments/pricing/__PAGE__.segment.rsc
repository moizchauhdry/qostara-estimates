2d:["$","$L2",null,{"className":"min-w-0","children":["$","$L36",null,{"type":"single","collapsible":true,"className":"w-full min-w-0 space-y-3","children":[["$","$L37","How long does a typical estimate take?",{"value":"item-0","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L38",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"How long does a typical estimate take?"}],["$","$L39",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Most commercial packages return in 3–5 business days. Large healthcare and industrial sets are scoped individually. Rush turnarounds are available when bid dates demand it."}]]}],["$","$L37","Can you work with our existing templates?",{"value":"item-1","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L38",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"Can you work with our existing templates?"}],["$","$L39",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Absolutely. We deliver in your CSI structure, Excel workbook, or estimating software export — including Sage, Destini, and HeavyBid formats on request."}]]}],["$","$L37","What happens when an addendum drops?",{"value":"item-2","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L38",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"What happens when an addendum drops?"}],["$","$L39",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"We revise the takeoff and the cost model, highlight the delta, and return an updated package. Active bids include addendum support through the submission date."}]]}],["$","$L37","Do you offer ongoing estimating support?",{"value":"item-3","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L38",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"Do you offer ongoing estimating support?"}],["$","$L39",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Many clients keep Qostara on retainer for a book of work. That gives you priority scheduling and a named estimator who already knows your standards."}]]}],["$","$L37","How do we get started?",{"value":"item-4","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L38",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"How do we get started?"}],["$","$L39",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Share drawings through the contact form or book a 15-minute scoping call. We confirm scope, timeline, and fee before any work begins — no surprises."}]]}]]}]}]
