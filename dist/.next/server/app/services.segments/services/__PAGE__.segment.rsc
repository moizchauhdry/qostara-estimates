29:["$","$L2",null,{"className":"min-w-0","children":["$","$L32",null,{"type":"single","collapsible":true,"className":"w-full min-w-0 space-y-3","children":[["$","$L33","What documents can you work from?",{"value":"item-0","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L34",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"What documents can you work from?"}],["$","$L35",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Depending on the project, our estimators can work from architectural, structural, MEP, and civil drawings, specifications, addendums, bid documents, scope documents, schedules, existing takeoffs, vendor quotations, and contractor-provided pricing. The more complete the documentation, the more comprehensive the estimate can be."}]]}],["$","$L33","Can you estimate a single trade, or only a full project?",{"value":"item-1","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L34",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"Can you estimate a single trade, or only a full project?"}],["$","$L35",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Both. Whether you need a single-trade takeoff or a complete multi-trade estimate, we help turn complex construction documents into usable cost information. You can use Qostara for a single project, a specific trade, or ongoing estimating requirements."}]]}],["$","$L33","What does a Qostara estimate include?",{"value":"item-2","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L34",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"What does a Qostara estimate include?"}],["$","$L35",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"The exact structure is tailored to your project and scope. An estimate can include material and labor quantities and costs, equipment, subcontractor costs, assemblies, allowances, overhead, markup, exclusions, assumptions, scope notes, and bid summaries."}]]}],["$","$L33","Which trades do you cover?",{"value":"item-3","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L34",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"Which trades do you cover?"}],["$","$L35",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Our estimating capabilities span general construction, structural and architectural scopes, MEP (mechanical, HVAC, plumbing, electrical, fire protection, fire alarm, low voltage, and telecommunications), and site and civil work. We also provide architectural, structural, and MEP shop drawing and detailing services."}]]}],["$","$L33","Who do you work with?",{"value":"item-4","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L34",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"Who do you work with?"}],["$","$L35",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"General contractors, subcontractors, builders, developers, and other construction professionals — from smaller residential projects to large commercial and industrial developments."}]]}],"$L36"]}]}]
