1b:T598,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What drawing formats do you accept?","acceptedAnswer":{"@type":"Answer","text":"PDF is the most common. We also work from DWG, DXF, and Revit models. If you have a Bluebeam session or Procore link, we can pull from that too."}},{"@type":"Question","name":"How long does a typical estimate take?","acceptedAnswer":{"@type":"Answer","text":"Most commercial packages return in 3–5 business days. Large healthcare and industrial sets are scoped individually. Rush turnarounds are available when bid dates demand it."}},{"@type":"Question","name":"Do you estimate every trade?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our team covers concrete, steel, envelope, MEP, finishes, and site work. Specialty trades like fire protection and cleanroom systems are handled by dedicated estimators."}},{"@type":"Question","name":"How do you keep pricing current?","acceptedAnswer":{"@type":"Answer","text":"Regional cost libraries are refreshed weekly from supplier quotes, union wage updates, and awarded-job feedback. Clients can also supply preferred vendor pricing."}},{"@type":"Question","name":"Can you work with our existing templates?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. We deliver in your CSI structure, Excel workbook, or estimating software export — including Sage, Destini, and HeavyBid formats on request."}}]}c:["$","section",null,{"id":"contact-faq","className":"scroll-mt-28 bg-white py-20 sm:py-24 lg:py-28","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],["$","div",null,{"className":"shell grid w-full min-w-0 gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"className":"min-w-0 lg:sticky lg:top-32 lg:self-start","children":[["$","$L2",null,{"className":"max-w-3xl","children":[["$","p",null,{"className":"eyebrow text-signal-600","children":[["$","span",null,{"aria-hidden":true,"className":"h-