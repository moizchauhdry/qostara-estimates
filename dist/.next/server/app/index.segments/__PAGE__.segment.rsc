51:Tab3,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What drawing formats do you accept?","acceptedAnswer":{"@type":"Answer","text":"PDF is the most common. We also work from DWG, DXF, and Revit models. If you have a Bluebeam session or Procore link, we can pull from that too."}},{"@type":"Question","name":"How long does a typical estimate take?","acceptedAnswer":{"@type":"Answer","text":"Most commercial packages return in 3–5 business days. Large healthcare and industrial sets are scoped individually. Rush turnarounds are available when bid dates demand it."}},{"@type":"Question","name":"Do you estimate every trade?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our team covers concrete, steel, envelope, MEP, finishes, and site work. Specialty trades like fire protection and cleanroom systems are handled by dedicated estimators."}},{"@type":"Question","name":"How do you keep pricing current?","acceptedAnswer":{"@type":"Answer","text":"Regional cost libraries are refreshed weekly from supplier quotes, union wage updates, and awarded-job feedback. Clients can also supply preferred vendor pricing."}},{"@type":"Question","name":"Can you work with our existing templates?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. We deliver in your CSI structure, Excel workbook, or estimating software export — including Sage, Destini, and HeavyBid formats on request."}},{"@type":"Question","name":"What happens when an addendum drops?","acceptedAnswer":{"@type":"Answer","text":"We revise the takeoff and the cost model, highlight the delta, and return an updated package. Active bids include addendum support through the submission date."}},{"@type":"Question","name":"Is my project data kept confidential?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every engagement is covered by an NDA. Drawings live in encrypted storage and are purged on a schedule you set after the bid is sealed."}},{"@type":"Question","name":"Do you offer ongoing estimating support?","acceptedAnswer":{"@type":"Answer","text":"Many clients keep Qostara on retainer for a book of work. That gives you priority scheduling and a named estimator who already knows your standards."}},{"@type":"Question","name":"Can owners and developers hire Qostara directly?","acceptedAnswer":{"@type":"Answer","text":"Yes. We produce independent quantity surveys and conceptual budgets for owners, developers, and lenders who need a second set of eyes on cost."}},{"@type":"Question","name":"How do we get started?","acceptedAnswer":{"@type":"Answer","text":"Share drawings through the contact form or book a 15-minute scoping call. We confirm scope, timeline, and fee before any work begins — no surprises."}}]}f:["$","section",null,{"id":"faq","className":"scroll-mt-28 bg-white py-20 sm:py-24 lg:py-28","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$51"}}],["$","div",null,{"className":"shell grid w-full min-w-0 gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"className":"min-w-0 lg:sticky lg:top-32 lg:self-start","children":[["$","$L2",null,{"className":"max-w-3xl","children":[["$","p",null,{"className":"eyebrow text-signal-600","children":[["$","span",null,{"aria-hidden":true,"className":"h-px w-6 bg-signal-500/50"}],"FAQ"]}],["$","h2",null,{"className":"mt-5 text-[2rem] leading-[1.1] font-semibold text-balance sm:text-4xl lg:text-5xl","children":"Questions, answered"}],"$L52"]}],"$L53"]}],"$L54"]}]]}]
