54:["$","$L2",null,{"className":"min-w-0","children":["$","$L5d",null,{"type":"single","collapsible":true,"className":"w-full min-w-0 space-y-3","children":[["$","$L5e","What drawing formats do you accept?",{"value":"item-0","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L5f",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"What drawing formats do you accept?"}],["$","$L60",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"PDF is the most common. We also work from DWG, DXF, and Revit models. If you have a Bluebeam session or Procore link, we can pull from that too."}]]}],["$","$L5e","How long does a typical estimate take?",{"value":"item-1","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L5f",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"How long does a typical estimate take?"}],["$","$L60",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Most commercial packages return in 3–5 business days. Large healthcare and industrial sets are scoped individually. Rush turnarounds are available when bid dates demand it."}]]}],["$","$L5e","Do you estimate every trade?",{"value":"item-2","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L5f",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"Do you estimate every trade?"}],["$","$L60",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Yes. Our team covers concrete, steel, envelope, MEP, finishes, and site work. Specialty trades like fire protection and cleanroom systems are handled by dedicated estimators."}]]}],["$","$L5e","How do you keep pricing current?",{"value":"item-3","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L5f",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"How do you keep pricing current?"}],["$","$L60",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Regional cost libraries are refreshed weekly from supplier quotes, union wage updates, and awarded-job feedback. Clients can also supply preferred vendor pricing."}]]}],["$","$L5e","Can you work with our existing templates?",{"value":"item-4","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L5f",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"Can you work with our existing templates?"}],["$","$L60",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"Absolutely. We deliver in your CSI structure, Excel workbook, or estimating software export — including Sage, Destini, and HeavyBid formats on request."}]]}],["$","$L5e","What happens when an addendum drops?",{"value":"item-5","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":[["$","$L5f",null,{"className":"py-5 text-left text-base font-semibold break-words text-ink-950 hover:no-underline","children":"What happens when an addendum drops?"}],["$","$L60",null,{"className":"pb-5 text-sm leading-relaxed text-pretty text-ink-500 sm:text-base","children":"We revise the takeoff and the cost model, highlight the delta, and return an updated package. Active bids include addendum support through the submission date."}]]}],["$","$L5e","Is my project data kept confidential?",{"value":"item-6","className":"panel border-none px-4 data-[state=open]:shadow-lifted sm:px-6","children":["$L61","$L62"]}],"$L63","$L64","$L65"]}]}]
