# cPanel mailbox SMTP (outgoing). IMAP/POP3 is only for reading mail in an app.
SMTP_HOST=qostaraestimates.com
SMTP_PORT=465
SMTP_USER=info@qostaraestimates.com
SMTP_PASS=

# Inbox that receives contact-form notifications.
CONTACT_TO_EMAIL=info@qostaraestimates.com

# Must be a mailbox on this SMTP account (usually the same as SMTP_USER).
CONTACT_FROM_EMAIL=Qostara <info@qostaraestimates.com>

# Optional overrides once the site is live:
# EMAIL_LOGO_URL=https://qostaraestimates.com/brand/logo.png
# EMAIL_ASSET_BASE_URL=https://qostaraestimates.com
