# Resend — create a key at https://resend.com/api-keys (starts with re_)
# Paste the FULL key — no placeholder characters.
RESEND_API_KEY=

# With onboarding@resend.dev you can ONLY send to the email on your Resend account.
# Put that email here for local testing (not hello@qostaraestimates.com yet).
CONTACT_TO_EMAIL=

# Free test sender from Resend. For production, verify your domain and use:
# CONTACT_FROM_EMAIL="Qostara <hello@qostaraestimates.com>"
CONTACT_FROM_EMAIL="Qostara <onboarding@resend.dev>"
