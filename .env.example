# Resend — create a key at https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=re_xxxxxxxx

# Inbox for contact form notifications.
# With onboarding@resend.dev this MUST be the email on your Resend account.
CONTACT_TO_EMAIL=you@example.com

# Do not wrap in extra quotes in the Vercel dashboard.
CONTACT_FROM_EMAIL=Qostara <onboarding@resend.dev>

