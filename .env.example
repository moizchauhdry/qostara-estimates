# ── Site identity & contact details ──────────────────────────────────────────
# NEXT_PUBLIC_* values are inlined at BUILD time (npm run build / build:dist),
# so set them in .env on the machine that builds, then rebuild after changing.
# Every value is optional: anything left blank falls back to the built-in default.
NEXT_PUBLIC_SITE_URL=https://qostaraestimates.com
NEXT_PUBLIC_SITE_NAME=Qostara
NEXT_PUBLIC_LEGAL_NAME=Qostara Estimates
NEXT_PUBLIC_SHORT_TAGLINE=Estimates
NEXT_PUBLIC_TAGLINE=Construction Estimating Built for Confident Bidding
# NEXT_PUBLIC_DESCRIPTION=Professional construction estimating, quantity takeoffs, MEP estimating, and shop drawing services ...

NEXT_PUBLIC_EMAIL=hello@qostaraestimates.com
NEXT_PUBLIC_PHONE=+1 (415) 555-0182
# Defaults to a tel: link built from NEXT_PUBLIC_PHONE.
# NEXT_PUBLIC_PHONE_HREF=tel:+14155550182
NEXT_PUBLIC_HOURS=Mon–Fri, 7:00am–6:00pm PT

NEXT_PUBLIC_ADDRESS_LINE1=420 Market Street, Suite 800
NEXT_PUBLIC_ADDRESS_LOCALITY=San Francisco
NEXT_PUBLIC_ADDRESS_REGION=CA
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=94105
NEXT_PUBLIC_ADDRESS_COUNTRY=US

# ── Social links ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/
NEXT_PUBLIC_SOCIAL_X=https://x.com/
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/

# ── Email delivery (server-side, read at runtime) ────────────────────────────
# cPanel mailbox SMTP (outgoing). IMAP/POP3 is only for reading mail in an app.
# SMTP_HOST defaults to the hostname of NEXT_PUBLIC_SITE_URL.
SMTP_HOST=qostaraestimates.com
SMTP_PORT=465
SMTP_USER=info@qostaraestimates.com
SMTP_PASS=

# Inbox that receives contact-form notifications.
CONTACT_TO_EMAIL=info@qostaraestimates.com

# Must be a mailbox on this SMTP account (usually the same as SMTP_USER).
CONTACT_FROM_EMAIL=Qostara <info@qostaraestimates.com>

# ── Email assets (optional) ──────────────────────────────────────────────────
# EMAIL_LOGO_URL=https://qostaraestimates.com/brand/logo.png
# EMAIL_ASSET_BASE_URL=https://qostaraestimates.com

# Hero images used in email templates (defaults are Unsplash photos).
# EMAIL_IMAGE_WELCOME=
# EMAIL_IMAGE_ESTIMATE_READY=
# EMAIL_IMAGE_RELATIONSHIP=
# EMAIL_IMAGE_NEWSLETTER=
# EMAIL_IMAGE_PROMOTION=

# Sample meeting link used only by `npx tsx emails/preview.ts`.
# EMAIL_PREVIEW_MEETING_URL=
